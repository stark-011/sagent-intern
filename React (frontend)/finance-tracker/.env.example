# Leave empty in local dev to use CRA proxy (recommended)
REACT_APP_API_BASE_URL=

# Enable only if your backend exposes dedicated auth endpoints
# REACT_APP_ENABLE_AUTH_ENDPOINTS=true

# Set this in production only if frontend/backend are on different origins
# REACT_APP_API_BASE_URL=https://your-api.example.com

# Optional: custom local proxy target for CRA setupProxy
# REACT_APP_PROXY_TARGET=http://localhost:8080
